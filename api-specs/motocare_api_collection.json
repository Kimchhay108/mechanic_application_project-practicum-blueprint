{
  "info": {
    "name": "MotoCare Cambodia API Test Collection",
    "_postman_id": "7a3e8d91-5b2c-4f1e-9a8d-2c4e6f8a0b12",
    "description": "API contract verification collection for MotoCare Cambodia capstone (Phase 3.4)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "mock_jwt_token_for_kimchhay",
      "type": "string"
    },
    {
      "key": "vehicleId",
      "value": "e4a77b80-1a22-4cf4-90a6-5c58c148f980",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "EP-01 Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Health status is ok', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql('ok');",
              "    pm.expect(jsonData.timestamp).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "EP-02 Create Vehicle Profile",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vehicle_model_id\": \"9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d\",\n  \"license_plate\": \"1JJ-8888\",\n  \"current_odometer\": 12450\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/vehicles",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "vehicles"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Vehicle created with bound reminders', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.id).to.be.a('string');",
              "    pm.expect(jsonData.data.bound_reminders_count).to.be.above(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "EP-03 List User Vehicles",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/vehicles",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "vehicles"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Vehicles returned with health status summary', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.be.an('array');",
              "    if (jsonData.data.length > 0) {",
              "        pm.expect(jsonData.data[0].health_summary).to.have.property('status');",
              "    }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "EP-04 Update Odometer",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"odometer_km\": 13500,\n  \"source\": \"manual\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/vehicles/{{vehicleId}}/odometer",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "vehicles", "{{vehicleId}}", "odometer"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Odometer updated and reminders re-evaluated', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.current_odometer).to.eql(13500);",
              "    pm.expect(jsonData.data.updated_reminders).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "EP-05 Get Vehicle Reminders",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/vehicles/{{vehicleId}}/reminders",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "vehicles", "{{vehicleId}}", "reminders"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Reminders returned with Khmer names and status', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.be.an('array');",
              "    if (jsonData.data.length > 0) {",
              "        pm.expect(jsonData.data[0].component.name_km).to.be.a('string');",
              "        pm.expect(['upcoming', 'due_soon', 'overdue', 'serviced']).to.include(jsonData.data[0].status);",
              "    }",
              "});"
            ]
          }
        }
      ]
    },
